**/__pycache__/
*.pyc
.venv/
.env
*.sqlite3
.DS_Store
*.db

# SQLite keeps a write-ahead log and a shared-memory file beside the
# database while it is open, and a running server writes a log of its own.
# None of them is source, and a *.db entry alone leaves all three behind.
*.db-wal
*.db-shm
*.log

# File Integrity Monitor writes its baseline next to the folder it watches.
baseline.json

# The SIEM writes uploaded captures and alert logs beside the database.
captures/
*.jsonl

# Tests keep their temporary files inside the project, so the suite does not
# depend on the system temp directory being readable.
.pytest_tmp/

# pytest also leaves a cache directory beside each project's tests, holding the
# last run's node ids and failure list. It is regenerated on every run and has no
# business in the repository, but a *.pyc entry does not cover it.
.pytest_cache/
