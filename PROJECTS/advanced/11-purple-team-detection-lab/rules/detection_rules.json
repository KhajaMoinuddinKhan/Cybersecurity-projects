[
  {
    "rule_id": "DET-001",
    "title": "Repeated authentication failures",
    "description": "Multiple failed logins from the same source within a short time window.",
    "severity": "High",
    "technique_id": "T1110",
    "technique_name": "Brute Force",
    "type": "threshold",
    "group_by": "source",
    "threshold": 5,
    "window_minutes": 10,
    "conditions": [
      {"field": "event_type", "operator": "equals", "value": "auth_failure"}
    ]
  },
  {
    "rule_id": "DET-002",
    "title": "Encoded PowerShell command",
    "description": "PowerShell started with a command line that contains an encoded-command flag.",
    "severity": "High",
    "technique_id": "T1059.001",
    "technique_name": "PowerShell",
    "type": "match",
    "conditions": [
      {"field": "event_type", "operator": "equals", "value": "process_start"},
      {"field": "image", "operator": "contains", "value": "powershell.exe"},
      {"field": "command_line", "operator": "contains", "value": "-enc"}
    ]
  },
  {
    "rule_id": "DET-003",
    "title": "Large outbound transfer",
    "description": "A single outbound connection transferred at least 50 MB.",
    "severity": "Medium",
    "technique_id": "T1041",
    "technique_name": "Exfiltration Over C2 Channel",
    "type": "match",
    "conditions": [
      {"field": "event_type", "operator": "equals", "value": "network_connection"},
      {"field": "direction", "operator": "equals", "value": "outbound"},
      {"field": "bytes_out", "operator": "greater_or_equal", "value": 50000000}
    ]
  },
  {
    "rule_id": "DET-004",
    "title": "Administrator group membership changed",
    "description": "A user was added to a local administrator group.",
    "severity": "Medium",
    "technique_id": "T1098",
    "technique_name": "Account Manipulation",
    "type": "match",
    "conditions": [
      {"field": "event_type", "operator": "equals", "value": "group_membership_change"},
      {"field": "group", "operator": "contains", "value": "admin"},
      {"field": "action", "operator": "equals", "value": "added"}
    ]
  },
  {
    "rule_id": "DET-005",
    "title": "Unsigned script blocked by endpoint control",
    "description": "Endpoint protection blocked a script marked as unsigned.",
    "severity": "Low",
    "technique_id": "T1059",
    "technique_name": "Command and Scripting Interpreter",
    "type": "match",
    "conditions": [
      {"field": "event_type", "operator": "equals", "value": "endpoint_alert"},
      {"field": "action", "operator": "equals", "value": "blocked"},
      {"field": "signature_status", "operator": "equals", "value": "unsigned"}
    ]
  }
]
